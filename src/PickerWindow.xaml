<Window x:Class="BigPhone.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Phone" WindowState="Maximized"
        Width="1100" Height="850" Background="#101010" Foreground="White"
        FontFamily="Segoe UI" ShowInTaskbar="False" KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Contact rows: no Viewbox, so every name gets the same (large) size. Sizes are set from code. -->
        <Style x:Key="ContactRow" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E4C9A"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="{DynamicResource RowHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20"
                                BorderBrush="#5A5A5A" BorderThickness="4" Padding="28,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD600"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Background="#0D3B66" CornerRadius="16" Margin="8">
            <Viewbox Margin="20,6" StretchDirection="DownOnly">
                <TextBlock x:Name="HeaderText" Text="" FontSize="64" FontWeight="Bold"/>
            </Viewbox>
        </Border>
        <Button Grid.Column="1" Style="{StaticResource Big}" Background="#C62828" Click="Close_Click">
            <TextBlock Text="✖ CLOSE"/>
        </Button>

        <!-- Scrolling list (mouse wheel, touch drag, or the big arrow buttons) -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"
                      ScrollChanged="Scroller_ScrollChanged" SizeChanged="Scroller_SizeChanged">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ContactRow}" Click="Item_Click" Tag="{Binding}" Background="{Binding Background}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource NameSize}" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource NumberSize}"
                                           Foreground="#CCDDFF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" FontSize="40"
                   Foreground="#BBB" Margin="30" VerticalAlignment="Center" TextAlignment="Center"
                   Text=""/>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button x:Name="UpButton" Style="{StaticResource Big}" Click="Up_Click" ToolTip="Show earlier names">
                <TextBlock Text="▲"/>
            </Button>
            <Button x:Name="DownButton" Grid.Row="1" Style="{StaticResource Big}" Click="Down_Click" ToolTip="Show more names">
                <TextBlock Text="▼"/>
            </Button>
        </Grid>
    </Grid>
</Window>
