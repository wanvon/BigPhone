<Window x:Class="BigPhone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Phone – Settings" Width="900" Height="820" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#1A1A1A" Foreground="White"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="36" FontWeight="Bold" Margin="0,0,0,6"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="SOUND" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,10,6,0"/>

                <TextBlock Text="Speaker / headset (you hear the caller here)" Style="{StaticResource DlgLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="OutputBox" Style="{StaticResource DlgCombo}"/>
                    <Button Grid.Column="1" Content="▶ Test" Style="{StaticResource DlgButton}" MinHeight="0" Padding="16,4" Margin="6,0,6,6" Click="TestOutput_Click"/>
                </Grid>

                <TextBlock Text="Microphone" Style="{StaticResource DlgLabel}"/>
                <ComboBox x:Name="InputBox" Style="{StaticResource DlgCombo}"/>

                <TextBlock Text="Ring sound plays on" Style="{StaticResource DlgLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RingBox" Style="{StaticResource DlgCombo}"/>
                    <Button Grid.Column="1" Content="▶ Test" Style="{StaticResource DlgButton}" MinHeight="0" Padding="16,4" Margin="6,0,6,6" Click="TestRing_Click"/>
                </Grid>

                <TextBlock Text="CALLS" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,24,6,0"/>
                <CheckBox x:Name="SpeakCallerBox" Style="{StaticResource DlgCheck}" Content="Say the caller's name out loud (&quot;Call from Mom&quot;)"/>
                <CheckBox x:Name="SpeakStatusBox" Style="{StaticResource DlgCheck}" Content="Also say &quot;Calling…&quot;, &quot;Call ended&quot;, etc."/>
                <CheckBox x:Name="USCodeBox" Style="{StaticResource DlgCheck}" Content="Add 1 in front of 10-digit US numbers"/>

                <TextBlock Text="Answer calls automatically" Style="{StaticResource DlgLabel}"/>
                <ComboBox x:Name="AutoAnswerBox" Style="{StaticResource DlgCombo}"/>

                <TextBlock Text="TEXT MESSAGES" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,24,6,0"/>
                <TextBlock FontSize="16" Foreground="#AAA" TextWrapping="Wrap" Margin="6,4,6,0">
                    FlyNumber can't send texts to apps directly; it emails each one. Big Phone reads those emails
                    (only ones from notifications@mail.flynumber.com) and shows the text in big print, with a COPY CODE
                    button for one-time codes. In the FlyNumber panel, under Settings → Notifications, send SMS emails
                    to the address below.
                </TextBlock>
                <CheckBox x:Name="TextsEnabledBox" Style="{StaticResource DlgCheck}" Content="Show text messages in Big Phone"/>

                <TextBlock Text="Email provider" Style="{StaticResource DlgLabel}"/>
                <ComboBox x:Name="ProviderBox" Style="{StaticResource DlgCombo}" SelectionChanged="Provider_Changed"/>
                <TextBlock Text="Email server (IMAP)" Style="{StaticResource DlgLabel}"/>
                <TextBox x:Name="ImapHostBox" Style="{StaticResource DlgText}" FontSize="24"/>
                <StackPanel x:Name="PasswordPanel">
                    <TextBlock Text="Email address" Style="{StaticResource DlgLabel}"/>
                    <TextBox x:Name="ImapUserBox" Style="{StaticResource DlgText}" FontSize="24"/>
                    <TextBlock x:Name="ImapPasswordLabel" Text="App password" Style="{StaticResource DlgLabel}"/>
                    <PasswordBox x:Name="ImapPasswordBox" FontSize="24" Padding="8,4" Margin="6,0,6,6"/>
                </StackPanel>
                <TextBlock x:Name="ProviderHelp" FontSize="16" Foreground="#AAA" TextWrapping="Wrap" Margin="6,0,6,6"/>
                <StackPanel x:Name="GooglePanel" Visibility="Collapsed">
                    <TextBlock Text="1. Google app ID (the JSON file downloaded from Google Cloud Console)" Style="{StaticResource DlgLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📂 Choose file…" Style="{StaticResource DlgButton}" Click="ChooseGoogleClient_Click"/>
                        <TextBlock x:Name="GoogleClientStatus" Grid.Column="1" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>
                    <TextBlock Text="2. Sign in and pick your account from Google's list" Style="{StaticResource DlgLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="GoogleSignInButton" Content="Sign in with Google" Style="{StaticResource DlgButton}" Background="#1E4C9A" Click="GoogleSignIn_Click"/>
                        <TextBlock x:Name="GoogleSignInStatus" Grid.Column="1" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Test connection" Style="{StaticResource DlgButton}" Click="TestImap_Click"/>
                    <TextBlock x:Name="ImapTestResult" Grid.Column="1" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                </Grid>
                <CheckBox x:Name="PopUpTextsBox" Style="{StaticResource DlgCheck}" Content="Open new texts full screen (not during calls)"/>
                <CheckBox x:Name="SpeakTextsBox" Style="{StaticResource DlgCheck}" Content="Read new texts out loud"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChimeTextsBox" Style="{StaticResource DlgCheck}" Content="Play a chime for new texts (soft during calls)"/>
                    <Button Grid.Column="1" Content="▶ Test" Style="{StaticResource DlgButton}" MinHeight="0" Padding="16,4" Click="TestChime_Click"/>
                </Grid>

                <TextBlock Text="STARTUP" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,24,6,0"/>
                <CheckBox x:Name="KeepRunningBox" Style="{StaticResource DlgCheck}"
                          Content="Start Big Phone with Windows and restart it if it closes"/>
                <TextBlock FontSize="16" Foreground="#AAA" TextWrapping="Wrap" Margin="6,0,6,6"
                           Text="Adds a Windows scheduled task that checks every 5 minutes. Use this on the user's PC; leave it off on a helper's PC. (A Startup-folder shortcut is then not needed.)"/>

                <TextBlock Text="UPDATES" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,24,6,0"/>
                <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource DlgCheck}" Content="Install updates automatically (only when not on a call)"/>

                <TextBlock x:Name="InfoText" FontSize="16" Foreground="#999" TextWrapping="Wrap" Margin="6,20,6,6"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{StaticResource DlgButton}" MinWidth="180" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="✔ Save" Style="{StaticResource DlgButton}" MinWidth="220" Background="#1B8E3A" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
