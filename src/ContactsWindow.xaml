<Window x:Class="BigPhone.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Phone – Contacts" Width="1000" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Contacts" FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="These appear, in this order, when the CONTACTS button is pressed. The first 6 can also be called with F1–F6. Incoming calls from these numbers show the name."
                       FontSize="18" Foreground="{DynamicResource SubtleFg}" TextWrapping="Wrap" Margin="0,4,0,8"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- List -->
            <ListBox x:Name="List" FontSize="26" Background="{DynamicResource ListBg}" Foreground="{DynamicResource Fg}" BorderBrush="{DynamicResource Border}"
                     BorderThickness="2" Margin="6" SelectionChanged="List_SelectionChanged"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" Foreground="{DynamicResource HeadingFg}" FontWeight="Bold"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Number}" FontSize="18" Foreground="{DynamicResource SubtleFg}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Editor -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Name (shown on the button)" Style="{StaticResource DlgLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource DlgText}" MaxLength="20" TextChanged="Editor_TextChanged"/>
                <TextBlock Text="Phone number" Style="{StaticResource DlgLabel}"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource DlgText}" MaxLength="24" TextChanged="Editor_TextChanged"/>
                <TextBlock Text="10 digits for US numbers (e.g. 941 555 1234). Start international numbers with +."
                           FontSize="16" Foreground="{DynamicResource SubtleFg}" TextWrapping="Wrap" Margin="6,0,6,10"/>

                <UniformGrid Columns="2">
                    <Button x:Name="AddButton" Content="＋ Add new" Style="{StaticResource DlgButton}" Background="#1E4C9A" Foreground="White" Click="Add_Click"/>
                    <Button x:Name="DeleteButton" Content="✖ Delete" Style="{StaticResource DlgButton}" Background="#7A1F1F" Foreground="White" Click="Delete_Click"/>
                    <Button x:Name="UpButton" Content="▲ Move up" Style="{StaticResource DlgButton}" Click="Up_Click"/>
                    <Button x:Name="DownButton" Content="▼ Move down" Style="{StaticResource DlgButton}" Click="Down_Click"/>
                </UniformGrid>

                <TextBlock x:Name="ErrorText" FontSize="20" Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap" Margin="6,10"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{StaticResource DlgButton}" MinWidth="180" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="✔ Save" Style="{StaticResource DlgButton}" MinWidth="220" Background="#1B8E3A" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
