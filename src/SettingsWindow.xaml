<Window x:Class="BigPhone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Phone – Settings" Width="900" Height="820" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#1A1A1A" Foreground="White"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="36" FontWeight="Bold" Margin="0,0,0,6"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="SOUND" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,10,6,0"/>

                <TextBlock Text="Speaker / headset (you hear the caller here)" Style="{StaticResource DlgLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="OutputBox" Style="{StaticResource DlgCombo}"/>
                    <Button Grid.Column="1" Content="▶ Test" Style="{StaticResource DlgButton}" MinHeight="0" Padding="16,4" Margin="6,0,6,6" Click="TestOutput_Click"/>
                </Grid>

                <TextBlock Text="Microphone" Style="{StaticResource DlgLabel}"/>
                <ComboBox x:Name="InputBox" Style="{StaticResource DlgCombo}"/>

                <TextBlock Text="Ring sound plays on" Style="{StaticResource DlgLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RingBox" Style="{StaticResource DlgCombo}"/>
                    <Button Grid.Column="1" Content="▶ Test" Style="{StaticResource DlgButton}" MinHeight="0" Padding="16,4" Margin="6,0,6,6" Click="TestRing_Click"/>
                </Grid>

                <TextBlock Text="CALLS" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,24,6,0"/>
                <CheckBox x:Name="SpeakCallerBox" Style="{StaticResource DlgCheck}" Content="Say the caller's name out loud (&quot;Call from Mom&quot;)"/>
                <CheckBox x:Name="SpeakStatusBox" Style="{StaticResource DlgCheck}" Content="Also say &quot;Calling…&quot;, &quot;Call ended&quot;, etc."/>
                <CheckBox x:Name="USCodeBox" Style="{StaticResource DlgCheck}" Content="Add 1 in front of 10-digit US numbers"/>

                <TextBlock Text="Answer calls automatically" Style="{StaticResource DlgLabel}"/>
                <ComboBox x:Name="AutoAnswerBox" Style="{StaticResource DlgCombo}"/>

                <TextBlock Text="UPDATES" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="6,24,6,0"/>
                <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource DlgCheck}" Content="Install updates automatically (only when not on a call)"/>

                <TextBlock x:Name="InfoText" FontSize="16" Foreground="#999" TextWrapping="Wrap" Margin="6,20,6,6"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{StaticResource DlgButton}" MinWidth="180" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="✔ Save" Style="{StaticResource DlgButton}" MinWidth="220" Background="#1B8E3A" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
