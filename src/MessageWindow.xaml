<Window x:Class="BigPhone.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Phone – Text message" WindowState="Maximized"
        Width="1100" Height="850" Background="#101010" Foreground="White"
        FontFamily="Segoe UI" ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition x:Name="CodeRow" Height="1.3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <!-- Who and when -->
        <Border Background="#0D3B66" CornerRadius="16" Margin="8">
            <Viewbox Margin="20,6" StretchDirection="DownOnly">
                <TextBlock x:Name="HeaderText" FontSize="60" FontWeight="Bold"/>
            </Viewbox>
        </Border>

        <!-- The code, if there is one -->
        <Border x:Name="CodeBanner" Grid.Row="1" Background="#3A3000" BorderBrush="#FFD600" BorderThickness="4"
                CornerRadius="16" Margin="8">
            <Viewbox Margin="20,6">
                <TextBlock x:Name="CodeText" FontWeight="Bold" Foreground="#FFD600" FontFamily="Consolas"/>
            </Viewbox>
        </Border>

        <!-- The message -->
        <Border Grid.Row="2" Background="White" CornerRadius="16" Margin="8">
            <ScrollViewer x:Name="BodyScroller" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"
                          Margin="20,12" SizeChanged="Body_SizeChanged">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="Black" FontSize="48"/>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CopyCodeColumn" Width="2.2*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition x:Name="CallBackColumn" Width="1.3*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyCodeButton" Style="{StaticResource Big}" Background="#1B8E3A" Click="CopyCode_Click">
                <TextBlock x:Name="CopyCodeText" Text="📋 COPY CODE"/>
            </Button>
            <Button x:Name="CopyTextButton" Grid.Column="1" Style="{StaticResource Big}" Background="#3A3A3A" Click="CopyText_Click">
                <TextBlock x:Name="CopyTextText" Text="📋 COPY TEXT"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Big}" Background="#3A3A3A" Click="Read_Click">
                <TextBlock Text="🔊 READ"/>
            </Button>
            <Button x:Name="CallBackButton" Grid.Column="3" Style="{StaticResource Big}" Background="#1E4C9A" Click="CallBack_Click">
                <TextBlock Text="📞 CALL"/>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource Big}" Background="#C62828" Click="Close_Click">
                <TextBlock Text="✖ CLOSE"/>
            </Button>
        </Grid>
    </Grid>
</Window>
